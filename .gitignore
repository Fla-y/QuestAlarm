############################################################
# Unity
############################################################

# Unity generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/

# Memory captures
[Mm]emoryCaptures/

# Asset Store tools
[Aa]ssets/AssetStoreTools*

# Unity autogenerated IDE/project files
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity crash reports
sysinfo.txt

# Unity packages / exports / mobile builds
*.apk
*.aab
*.unitypackage

# Standalone Unity build artifacts
*_BackUpThisFolder_ButDontShipItWithYourGame/
*_BurstDebugInformation_DoNotShip/
*_Data/

# If a Unity Windows build is accidentally created at repo root
*.exe
*.dll

# Keep source/plugin DLLs inside Assets if you ever need them
!/[Aa]ssets/**/*.dll

# IMPORTANT:
# Do NOT ignore *.meta in Unity projects.
# Unity .meta files contain GUIDs used for asset references.


