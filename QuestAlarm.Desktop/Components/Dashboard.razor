@page "/"
@inject DashboardDataService DashboardData
@inject DesktopRuntimeService RuntimeService

<header class="topbar">
    <div>
        <p class="eyebrow">Offline First</p>
        <h2>Alarm Command Center</h2>
    </div>
    <div class="toolbar-actions">
        <button class="refresh-button" type="button" @onclick="LoadAsync" disabled="@_isBusy">Refresh</button>
        <button class="toggle-button" type="button" @onclick="CreateTestAlarmAsync" disabled="@_isBusy">
            Test Alarm
        </button>
    </div>
</header>

@if (_snapshot is null)
{
    <div class="status-panel">Loading QuestAlarm data...</div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <p class="@(_statusIsError ? "form-error" : "form-success")">@_statusMessage</p>
    }

    <section class="metric-grid" aria-label="QuestAlarm summary">
        <div class="metric">
            <span>Alarms</span>
            <strong>@_snapshot.AlarmCount</strong>
        </div>
        <div class="metric">
            <span>Enabled</span>
            <strong>@_snapshot.EnabledAlarmCount</strong>
        </div>
        <div class="metric">
            <span>Sessions</span>
            <strong>@_snapshot.SessionCount</strong>
        </div>
    </section>

    <section class="panel runtime-overview">
        <div class="panel-heading">
            <h3>Desktop Runtime</h3>
            <span class="@GetRuntimeBadgeClass()">@(RuntimeService.IsRunning ? "Running" : "Stopped")</span>
        </div>

        <div class="runtime-grid">
            <div>
                <span>Callback API</span>
                <strong>@RuntimeService.CallbackUrl</strong>
            </div>
            <div>
                <span>Started</span>
                <strong>@(RuntimeService.StartedAtLocal?.ToString("yyyy-MM-dd HH:mm:ss") ?? "-")</strong>
            </div>
            <div>
                <span>Last Event</span>
                <strong>@(RuntimeService.LastEvent ?? "-")</strong>
            </div>
            <div>
                <span>Last Error</span>
                <strong class="@(string.IsNullOrWhiteSpace(RuntimeService.LastError) ? null : "runtime-error")">
                    @(RuntimeService.LastError ?? "-")
                </strong>
            </div>
        </div>

        <div class="form-actions">
            @if (RuntimeService.IsRunning)
            {
                <button class="toggle-button danger-button" type="button" @onclick="StopRuntimeAsync" disabled="@_isBusy">
                    Stop Runtime
                </button>
            }
            else
            {
                <button class="toggle-button" type="button" @onclick="StartRuntimeAsync" disabled="@_isBusy">
                    Start Runtime
                </button>
            }
        </div>
    </section>

    <section class="split-grid">
        <article class="panel">
            <div class="panel-heading">
                <h3>Next Alarm</h3>
                <span>@(_snapshot.NextAlarmOccurrenceLocal?.ToString("yyyy-MM-dd HH:mm") ?? "None")</span>
            </div>

            @if (_snapshot.NextAlarm is null)
            {
                <p class="empty">No enabled alarms found.</p>
            }
            else
            {
                <div class="alarm-focus">
                    <strong>@_snapshot.NextAlarm.Title</strong>
                    <span>@FormatAlarmSchedule(_snapshot.NextAlarm)</span>
                    <span>@FormatNextOccurrence(_snapshot.NextAlarmOccurrenceLocal)</span>
                </div>
            }
        </article>

        <article class="panel">
            <div class="panel-heading">
                <h3>Storage</h3>
                <span>Shared</span>
            </div>
            <p class="path">@_snapshot.StorageRoot</p>
        </article>
    </section>

    <section class="split-grid">
        <article class="panel">
            <div class="panel-heading">
                <h3>Recent Alarms</h3>
                <span>@_snapshot.RecentAlarms.Count</span>
            </div>
            <div class="list">
                @foreach (var alarm in _snapshot.RecentAlarms)
                {
                    <div class="list-row">
                        <div>
                            <strong>@alarm.Title</strong>
                            <span>@FormatAlarmSchedule(alarm)</span>
                        </div>
                        <em>@alarm.State</em>
                    </div>
                }
            </div>
        </article>

        <article class="panel">
            <div class="panel-heading">
                <h3>Recent Sessions</h3>
                <span>@_snapshot.RecentSessions.Count</span>
            </div>
            <div class="list">
                @foreach (var session in _snapshot.RecentSessions)
                {
                    <div class="list-row">
                        <div>
                            <strong>@session.State</strong>
                            <span>@session.TriggeredAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                        </div>
                        <em>@ShortId(session.Id)</em>
                    </div>
                }
            </div>
        </article>
    </section>
}

@code {
    private DashboardSnapshot? _snapshot;
    private bool _isBusy;
    private string? _statusMessage;
    private bool _statusIsError;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _snapshot = await DashboardData.GetSnapshotAsync();
        }
        catch (Exception ex)
        {
            SetStatus(ex.Message, isError: true);
        }
    }

    private async Task StartRuntimeAsync()
    {
        _isBusy = true;
        ClearStatus();

        try
        {
            await RuntimeService.StartAsync();
            SetStatus("Runtime started.", isError: false);
        }
        catch (Exception ex)
        {
            SetStatus(ex.Message, isError: true);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task StopRuntimeAsync()
    {
        _isBusy = true;
        ClearStatus();

        try
        {
            await RuntimeService.StopAsync();
            SetStatus("Runtime stopped.", isError: false);
        }
        catch (Exception ex)
        {
            SetStatus(ex.Message, isError: true);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task CreateTestAlarmAsync()
    {
        _isBusy = true;
        ClearStatus();

        try
        {
            var alarm = await RuntimeService.CreateTestAlarmDueSoonAsync();
            await LoadAsync();
            SetStatus($"Test alarm '{alarm.Title}' created.", isError: false);
        }
        catch (Exception ex)
        {
            SetStatus(ex.Message, isError: true);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private static string FormatAlarmSchedule(Core.Entities.Alarm alarm)
    {
        if (alarm.Schedule.IsRecurring)
        {
            var days = alarm.Schedule.RecurringDays.Count == 0
                ? "No days"
                : string.Join(", ", alarm.Schedule.RecurringDays);

            return $"{days} at {alarm.Schedule.Time:HH\\:mm}";
        }

        var date = alarm.Schedule.StartDate?.ToString("yyyy-MM-dd") ?? "-";
        return $"{date} at {alarm.Schedule.Time:HH\\:mm}";
    }

    private static string ShortId(Guid id)
    {
        return id.ToString("N")[..8];
    }

    private static string FormatNextOccurrence(DateTime? nextOccurrenceLocal)
    {
        return nextOccurrenceLocal is null
            ? "No next occurrence."
            : $"Next occurrence: {nextOccurrenceLocal:yyyy-MM-dd HH:mm:ss}";
    }

    private string GetRuntimeBadgeClass()
    {
        return RuntimeService.IsRunning
            ? "state-badge completed"
            : "state-badge failed";
    }

    private void SetStatus(string message, bool isError)
    {
        _statusMessage = message;
        _statusIsError = isError;
    }

    private void ClearStatus()
    {
        _statusMessage = null;
        _statusIsError = false;
    }
}
