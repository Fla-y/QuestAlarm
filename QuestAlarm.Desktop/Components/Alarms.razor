@page "/alarms"
@inject IAlarmAppService AlarmAppService

<div class="topbar">
    <div>
        <p class="eyebrow">Offline First</p>
        <h2>Alarms</h2>
    </div>
    <div class="toolbar-actions">
        <button class="refresh-button" type="button" @onclick="LoadAsync">Refresh</button>
    </div>
</div>

<section class="panel">
    <div class="panel-heading">
        <h3>@(_editingAlarmId is null ? "Create Alarm" : "Edit Alarm")</h3>
        @if (_editingAlarmId is not null)
        {
            <button class="refresh-button" type="button" @onclick="CancelEdit">Cancel Edit</button>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(_formError))
    {
        <p class="form-error">@_formError</p>
    }
    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <p class="@(_statusIsError ? "form-error" : "form-success")">@_statusMessage</p>
    }

    <div class="form-grid">
        <label>
            <span>Title</span>
            <input @bind="_form.Title" @bind:event="oninput" />
        </label>
        <label>
            <span>Time</span>
            <input type="time" step="60" value="@_form.Time" @onchange="UpdateTime" />
        </label>
        <label>
            <span>Type</span>
            <select @bind="_form.IsRecurring" disabled="@(_editingAlarmId is not null)">
                <option value="false">One-time</option>
                <option value="true">Recurring</option>
            </select>
        </label>
        <label>
            <span>Challenge Type</span>
            <select @bind="_form.ChallengeType">
                <option value="Typing">Typing</option>
            </select>
        </label>
        <label>
            <span>Challenge Difficulty</span>
            <select @bind="_form.ChallengeDifficulty">
                <option value="Easy">Easy</option>
                <option value="Normal">Normal</option>
                <option value="Hard">Hard</option>
            </select>
        </label>
        @if (_form.IsRecurring)
        {
            <div class="form-field wide-field">
                <span>Recurring Days</span>
                <div class="day-picker" role="group" aria-label="Recurring days">
                    @foreach (var day in WeekDays)
                    {
                        <label class="day-chip">
                            <input type="checkbox"
                                   checked="@_selectedRecurringDays.Contains(day)"
                                   @onchange="eventArgs => ToggleRecurringDay(day, eventArgs)" />
                            <span>@ShortDay(day)</span>
                        </label>
                    }
                </div>
            </div>
        }
        else
        {
            <label>
                <span>Date</span>
                <input type="date" value="@_form.StartDate" @onchange="UpdateStartDate" />
            </label>
        }
    </div>

    <div class="form-actions">
        <button class="toggle-button" type="button" @onclick="SubmitAsync" disabled="@(_isSubmitting || !CanSubmit())">
            @GetSubmitButtonText()
        </button>
    </div>
</section>

@if (_alarms is null)
{
    <div class="status-panel">Loading alarms...</div>
}
else if (_alarms.Count == 0)
{
    <div class="status-panel">No alarms found.</div>
}
else
{
    <section class="panel">
        <div class="panel-heading">
            <h3>Configured Alarms</h3>
            <span>@FilteredAlarms.Count() / @_alarms.Count</span>
        </div>

        <div class="filter-bar" role="group" aria-label="Alarm filters">
            @foreach (var filter in AlarmFilters)
            {
                <button class="@GetFilterButtonClass(filter)"
                        type="button"
                        @onclick="() => SetFilter(filter)">
                    <span>@GetFilterLabel(filter)</span>
                    <strong>@GetFilterCount(filter)</strong>
                </button>
            }
        </div>

        <div class="list">
            @foreach (var alarm in FilteredAlarms)
            {
                <div class="list-row">
                    <div class="alarm-summary">
                        <strong>@alarm.Title</strong>
                        <span>@FormatSchedule(alarm)</span>
                        <span>@alarm.ChallengeType / @alarm.ChallengeDifficulty</span>
                    </div>
                    <div class="alarm-actions">
                        <span class="@GetAlarmStateBadgeClass(alarm)">@GetAlarmStateLabel(alarm)</span>
                        <button class="toggle-button" type="button" @onclick="() => BeginEdit(alarm)">Edit</button>
                        <button class="toggle-button" type="button" @onclick="() => ToggleAsync(alarm.Id)">
                            @(alarm.IsEnabled ? "Disable" : "Enable")
                        </button>
                        @if (_pendingDeleteAlarmId == alarm.Id)
                        {
                            <button class="toggle-button danger-button" type="button" @onclick="() => ConfirmDeleteAsync(alarm.Id)">Confirm Delete</button>
                            <button class="toggle-button" type="button" @onclick="CancelDelete">Cancel</button>
                        }
                        else
                        {
                            <button class="toggle-button danger-button" type="button" @onclick="() => RequestDelete(alarm.Id)">Delete</button>
                        }
                    </div>
                </div>
            }
        </div>
    </section>
}

@code {
    private static readonly AlarmFilter[] AlarmFilters =
    [
        AlarmFilter.All,
        AlarmFilter.Enabled,
        AlarmFilter.Disabled,
        AlarmFilter.Missed,
        AlarmFilter.Completed
    ];

    private IReadOnlyList<Core.Entities.Alarm>? _alarms;
    private Guid? _editingAlarmId;
    private Guid? _pendingDeleteAlarmId;
    private AlarmFilter _selectedFilter = AlarmFilter.All;
    private string? _formError;
    private string? _statusMessage;
    private bool _statusIsError;
    private bool _isSubmitting;
    private readonly HashSet<DayOfWeek> _selectedRecurringDays = [DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday];
    private AlarmFormModel _form = NewDefaultOneTimeForm();

    private static readonly DayOfWeek[] WeekDays =
    [
        DayOfWeek.Monday,
        DayOfWeek.Tuesday,
        DayOfWeek.Wednesday,
        DayOfWeek.Thursday,
        DayOfWeek.Friday,
        DayOfWeek.Saturday,
        DayOfWeek.Sunday
    ];

    private IEnumerable<Core.Entities.Alarm> FilteredAlarms =>
        (_alarms ?? [])
        .Where(MatchesSelectedFilter)
        .OrderByDescending(alarm => alarm.IsEnabled)
        .ThenBy(alarm => alarm.Schedule.StartDate ?? DateOnly.MaxValue)
        .ThenBy(alarm => alarm.Schedule.Time)
        .ThenBy(alarm => alarm.Title);

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _alarms = await AlarmAppService.GetAlarmsAsync();
        }
        catch (Exception ex)
        {
            SetStatus(ex.Message, isError: true);
        }
    }

    private void SetFilter(AlarmFilter filter)
    {
        _selectedFilter = filter;
    }

    private async Task ToggleAsync(Guid alarmId)
    {
        ClearStatus();

        try
        {
            var alarm = await AlarmAppService.ToggleEnabledAsync(alarmId);
            if (alarm is null)
            {
                SetStatus("Alarm not found.", isError: true);
            }
            else
            {
                SetStatus($"Alarm '{alarm.Title}' {(alarm.IsEnabled ? "enabled" : "disabled")}.", isError: false);
            }

            await LoadAsync();
        }
        catch (Exception ex)
        {
            SetStatus(ex.Message, isError: true);
        }
    }

    private void BeginEdit(Core.Entities.Alarm alarm)
    {
        _editingAlarmId = alarm.Id;
        _pendingDeleteAlarmId = null;
        _formError = null;
        ClearStatus();
        _form = new AlarmFormModel(
            alarm.Title,
            alarm.Schedule.Time.ToString("HH:mm"),
            alarm.Schedule.IsRecurring,
            alarm.Schedule.StartDate?.ToString("yyyy-MM-dd"),
            alarm.Schedule.IsRecurring ? string.Join(",", alarm.Schedule.RecurringDays) : null,
            alarm.ChallengeType.ToString(),
            alarm.ChallengeDifficulty.ToString());

        _selectedRecurringDays.Clear();
        foreach (var day in alarm.Schedule.RecurringDays)
        {
            _selectedRecurringDays.Add(day);
        }
    }

    private void CancelEdit()
    {
        _editingAlarmId = null;
        _formError = null;
        _pendingDeleteAlarmId = null;
        ClearStatus();
        ResetForm();
    }

    private async Task SubmitAsync()
    {
        _formError = null;
        ClearStatus();

        try
        {
            _isSubmitting = true;
            SetStatus(_editingAlarmId is null ? "Creating alarm..." : "Saving alarm...", isError: false);
            await InvokeAsync(StateHasChanged);

            var submission = BuildSubmissionModel();
            string successMessage;

            if (_editingAlarmId is null)
            {
                var (alarm, error) = await AlarmAppService.CreateAsync(submission);
                if (error is not null)
                {
                    _formError = error;
                    return;
                }

                successMessage = $"Alarm '{alarm!.Title}' created.";
            }
            else
            {
                var (alarm, error) = await AlarmAppService.UpdateAsync(_editingAlarmId.Value, submission);
                if (error is not null)
                {
                    _formError = error;
                    return;
                }

                successMessage = $"Alarm '{alarm!.Title}' updated.";
            }

            _editingAlarmId = null;
            _pendingDeleteAlarmId = null;
            ResetForm();
            await LoadAsync();
            SetStatus($"{successMessage} Total alarms: {_alarms?.Count ?? 0}.", isError: false);
        }
        catch (Exception ex)
        {
            SetStatus(ex.Message, isError: true);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void RequestDelete(Guid alarmId)
    {
        _pendingDeleteAlarmId = alarmId;
        _formError = null;
        ClearStatus();
    }

    private void CancelDelete()
    {
        _pendingDeleteAlarmId = null;
    }

    private async Task ConfirmDeleteAsync(Guid alarmId)
    {
        ClearStatus();

        try
        {
            var wasDeleted = await AlarmAppService.DeleteAsync(alarmId);
            if (!wasDeleted)
            {
                SetStatus("Alarm not found.", isError: true);
                return;
            }

            if (_editingAlarmId == alarmId)
            {
                CancelEdit();
            }

            _pendingDeleteAlarmId = null;
            SetStatus("Alarm deleted.", isError: false);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            SetStatus(ex.Message, isError: true);
        }
    }

    private bool CanSubmit()
    {
        if (string.IsNullOrWhiteSpace(_form.Title) || string.IsNullOrWhiteSpace(_form.Time))
        {
            return false;
        }

        return _form.IsRecurring
            ? _selectedRecurringDays.Count > 0
            : !string.IsNullOrWhiteSpace(_form.StartDate);
    }

    private string GetSubmitButtonText()
    {
        if (_isSubmitting)
        {
            return _editingAlarmId is null ? "Creating..." : "Saving...";
        }

        return _editingAlarmId is null ? "Create" : "Save";
    }

    private void UpdateTime(ChangeEventArgs eventArgs)
    {
        _form.Time = eventArgs.Value?.ToString() ?? string.Empty;
    }

    private void UpdateStartDate(ChangeEventArgs eventArgs)
    {
        _form.StartDate = eventArgs.Value?.ToString();
    }

    private void ToggleRecurringDay(DayOfWeek day, ChangeEventArgs eventArgs)
    {
        if (eventArgs.Value is bool isSelected && isSelected)
        {
            _selectedRecurringDays.Add(day);
            return;
        }

        _selectedRecurringDays.Remove(day);
    }

    private AlarmFormModel BuildSubmissionModel()
    {
        if (!_form.IsRecurring)
        {
            return new AlarmFormModel(
                _form.Title,
                _form.Time,
                isRecurring: false,
                _form.StartDate,
                recurringDaysCsv: null,
                _form.ChallengeType,
                _form.ChallengeDifficulty);
        }

        var recurringDaysCsv = string.Join(",", WeekDays.Where(_selectedRecurringDays.Contains));
        return new AlarmFormModel(
            _form.Title,
            _form.Time,
            isRecurring: true,
            startDate: null,
            recurringDaysCsv,
            _form.ChallengeType,
            _form.ChallengeDifficulty);
    }

    private void ResetDefaultRecurringDays()
    {
        _selectedRecurringDays.Clear();
        _selectedRecurringDays.Add(DayOfWeek.Monday);
        _selectedRecurringDays.Add(DayOfWeek.Tuesday);
        _selectedRecurringDays.Add(DayOfWeek.Wednesday);
        _selectedRecurringDays.Add(DayOfWeek.Thursday);
        _selectedRecurringDays.Add(DayOfWeek.Friday);
    }

    private void ResetForm()
    {
        _form = NewDefaultOneTimeForm();
        ResetDefaultRecurringDays();
    }

    private static string FormatSchedule(Core.Entities.Alarm alarm)
    {
        if (alarm.Schedule.IsRecurring)
        {
            var days = alarm.Schedule.RecurringDays.Count == 0
                ? "No days"
                : string.Join(", ", alarm.Schedule.RecurringDays);
            return $"{days} at {alarm.Schedule.Time:HH\\:mm}";
        }

        var date = alarm.Schedule.StartDate?.ToString("yyyy-MM-dd") ?? "-";
        return $"{date} at {alarm.Schedule.Time:HH\\:mm}";
    }

    private static AlarmFormModel NewDefaultOneTimeForm()
    {
        return new AlarmFormModel(
            title: string.Empty,
            time: "07:30",
            isRecurring: false,
            startDate: DateOnly.FromDateTime(DateTime.Now).ToString("yyyy-MM-dd"),
            recurringDaysCsv: "Mon,Tue,Wed,Thu,Fri",
            challengeType: "Typing",
            challengeDifficulty: "Normal");
    }

    private bool MatchesSelectedFilter(Core.Entities.Alarm alarm)
    {
        return _selectedFilter switch
        {
            AlarmFilter.Enabled => alarm.IsEnabled,
            AlarmFilter.Disabled => !alarm.IsEnabled,
            AlarmFilter.Missed => alarm.State == Core.Enums.AlarmState.Missed,
            AlarmFilter.Completed => alarm.State == Core.Enums.AlarmState.Completed,
            _ => true
        };
    }

    private int GetFilterCount(AlarmFilter filter)
    {
        if (_alarms is null)
        {
            return 0;
        }

        return filter switch
        {
            AlarmFilter.Enabled => _alarms.Count(alarm => alarm.IsEnabled),
            AlarmFilter.Disabled => _alarms.Count(alarm => !alarm.IsEnabled),
            AlarmFilter.Missed => _alarms.Count(alarm => alarm.State == Core.Enums.AlarmState.Missed),
            AlarmFilter.Completed => _alarms.Count(alarm => alarm.State == Core.Enums.AlarmState.Completed),
            _ => _alarms.Count
        };
    }

    private string GetFilterButtonClass(AlarmFilter filter)
    {
        return _selectedFilter == filter
            ? "filter-button active"
            : "filter-button";
    }

    private static string GetFilterLabel(AlarmFilter filter)
    {
        return filter switch
        {
            AlarmFilter.Enabled => "Enabled",
            AlarmFilter.Disabled => "Disabled",
            AlarmFilter.Missed => "Missed",
            AlarmFilter.Completed => "Completed",
            _ => "All"
        };
    }

    private static string GetAlarmStateLabel(Core.Entities.Alarm alarm)
    {
        if (!alarm.IsEnabled && alarm.State == Core.Enums.AlarmState.Scheduled)
        {
            return "Disabled";
        }

        return alarm.State.ToString();
    }

    private static string GetAlarmStateBadgeClass(Core.Entities.Alarm alarm)
    {
        if (!alarm.IsEnabled && alarm.State == Core.Enums.AlarmState.Scheduled)
        {
            return "state-badge disabled";
        }

        return alarm.State switch
        {
            Core.Enums.AlarmState.Completed => "state-badge completed",
            Core.Enums.AlarmState.Failed => "state-badge failed",
            Core.Enums.AlarmState.Missed => "state-badge failed",
            Core.Enums.AlarmState.Triggering => "state-badge running",
            Core.Enums.AlarmState.ChallengeRunning => "state-badge running",
            Core.Enums.AlarmState.Disabled => "state-badge disabled",
            Core.Enums.AlarmState.Scheduled when alarm.IsEnabled => "state-badge scheduled",
            _ => "state-badge"
        };
    }

    private static string ShortDay(DayOfWeek day)
    {
        return day.ToString()[..3];
    }

    private void SetStatus(string message, bool isError)
    {
        _statusMessage = message;
        _statusIsError = isError;
    }

    private void ClearStatus()
    {
        _statusMessage = null;
        _statusIsError = false;
    }

    private enum AlarmFilter
    {
        All,
        Enabled,
        Disabled,
        Missed,
        Completed
    }
}
