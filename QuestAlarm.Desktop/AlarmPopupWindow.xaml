<Window x:Class="QuestAlarm.Desktop.AlarmPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuestAlarm - Alarm Triggered"
        Width="440"
        Height="410"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Focusable="True"
        Background="#F8FAFC">
    <Border Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="QuestAlarm"
                           Foreground="#64748B"
                           FontWeight="Bold"
                           FontSize="13" />
                <TextBlock Text="Alarm Triggered"
                           Foreground="#111827"
                           FontWeight="Bold"
                           FontSize="28"
                           Margin="0,4,0,0" />
            </StackPanel>

            <Border Grid.Row="1"
                    Margin="0,22"
                    Padding="18"
                    CornerRadius="8"
                    BorderBrush="#D9E2EC"
                    BorderThickness="1"
                    Background="#FFFFFF">
                <StackPanel>
                    <TextBlock x:Name="AlarmTitleText"
                               Foreground="#111827"
                               FontWeight="Bold"
                               FontSize="22"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="ScheduledForText"
                               Margin="0,14,0,0"
                               Foreground="#334155"
                               FontSize="14" />
                    <TextBlock x:Name="TriggeredAtText"
                               Margin="0,6,0,0"
                               Foreground="#334155"
                               FontSize="14" />
                    <TextBlock x:Name="SessionIdText"
                               Margin="0,6,0,0"
                               Foreground="#64748B"
                               FontFamily="Cascadia Mono"
                               FontSize="12"
                               TextWrapping="Wrap" />
                    <Border x:Name="ChallengeStateBadge"
                            Margin="0,14,0,0"
                            Padding="10,6"
                            CornerRadius="999"
                            HorizontalAlignment="Left"
                            BorderBrush="#FDE68A"
                            BorderThickness="1"
                            Background="#FFFBEB">
                        <TextBlock x:Name="ChallengeStateText"
                                   Foreground="#92400E"
                                   FontWeight="Bold"
                                   FontSize="13" />
                    </Border>
                    <TextBlock x:Name="ChallengeStateDescriptionText"
                               Margin="0,10,0,0"
                               Foreground="#334155"
                               FontSize="13"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="ActivityStatusText"
                               Margin="0,10,0,0"
                               Foreground="#92400E"
                               FontWeight="SemiBold"
                               FontSize="13"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Button Grid.Row="2"
                    Width="120"
                    Height="38"
                    HorizontalAlignment="Right"
                    Content="Close (dev)"
                    Click="CloseButton_Click" />
        </Grid>
    </Border>
</Window>
