<main class="app-shell">
    <aside class="sidebar">
        <div class="brand">
            <span class="brand-mark">Q</span>
            <div>
                <h1>QuestAlarm</h1>
                <p>Escape Bed!</p>
            </div>
        </div>

        <nav class="nav-list" aria-label="Primary">
            <button class="@GetNavClass(Page.Dashboard)" type="button" @onclick="() => SetPage(Page.Dashboard)">Dashboard</button>
            <button class="@GetNavClass(Page.Alarms)" type="button" @onclick="() => SetPage(Page.Alarms)">Alarms</button>
            <button class="@GetNavClass(Page.Sessions)" type="button" @onclick="() => SetPage(Page.Sessions)">Sessions</button>
            <button class="@GetNavClass(Page.Runtime)" type="button" @onclick="() => SetPage(Page.Runtime)">Runtime</button>
            <button class="@GetNavClass(Page.Settings)" type="button" @onclick="() => SetPage(Page.Settings)">Settings</button>
        </nav>
    </aside>

    <section class="content">
        @switch (_currentPage)
        {
            case Page.Dashboard:
                <Dashboard />
                break;
            case Page.Alarms:
                <Alarms />
                break;
            case Page.Sessions:
                <Sessions />
                break;
            case Page.Runtime:
                <Runtime />
                break;
            case Page.Settings:
                <Settings />
                break;
        }
    </section>
</main>

@code {
    private Page _currentPage = Page.Dashboard;

    private void SetPage(Page page)
    {
        _currentPage = page;
    }

    private string GetNavClass(Page page)
    {
        return _currentPage == page ? "nav-item active" : "nav-item";
    }

    private enum Page
    {
        Dashboard,
        Alarms,
        Sessions,
        Runtime,
        Settings
    }
}
