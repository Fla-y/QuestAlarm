<Router AppAssembly="@typeof(Routes).Assembly">
    <Found Context="routeData">
        <main class="app-shell">
            <aside class="sidebar">
                <div class="brand">
                    <span class="brand-mark">Q</span>
                    <div>
                        <h1>QuestAlarm</h1>
                        <p>Escape Bed!</p>
                    </div>
                </div>

                <nav class="nav-list" aria-label="Primary">
                    <NavLink class="nav-item" href="" Match="NavLinkMatch.All">Dashboard</NavLink>
                    <NavLink class="nav-item" href="alarms">Alarms</NavLink>
                    <NavLink class="nav-item" href="sessions">Sessions</NavLink>
                    <NavLink class="nav-item" href="runtime">Runtime</NavLink>
                    <NavLink class="nav-item" href="settings">Settings</NavLink>
                </nav>
            </aside>

            <section class="content">
                <RouteView RouteData="@routeData" />
            </section>
        </main>
    </Found>
    <NotFound>
        <main class="app-shell">
            <aside class="sidebar">
                <div class="brand">
                    <span class="brand-mark">Q</span>
                    <div>
                        <h1>QuestAlarm</h1>
                        <p>Escape Bed!</p>
                    </div>
                </div>

                <nav class="nav-list" aria-label="Primary">
                    <NavLink class="nav-item" href="" Match="NavLinkMatch.All">Dashboard</NavLink>
                    <NavLink class="nav-item" href="alarms">Alarms</NavLink>
                    <NavLink class="nav-item" href="sessions">Sessions</NavLink>
                    <NavLink class="nav-item" href="runtime">Runtime</NavLink>
                    <NavLink class="nav-item" href="settings">Settings</NavLink>
                </nav>
            </aside>

            <section class="content">
                <Placeholder Title="Page not found"
                             Description="This QuestAlarm page does not exist yet." />
            </section>
        </main>
    </NotFound>
</Router>
